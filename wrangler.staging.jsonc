{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pokerrr-3-local",
  "main": "worker/staging.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "staging": {
      "name": "pokerrr-3-staging",
      "workers_dev": true,
      "vars": { "APP_ENV": "staging" }
    }
  }
}
